tca=d 0.1

part wod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85/ gcm^3

  param pin_dia = 72 mm range(10 mm, 60 mm)
  param jaw_gap = 26 mm
  param jaw_thk = 16 mm
  param body_len = 70 mm
  param thread = "M24x2"

  sketch side on plane.XZ {
    rect outline corner=(0 mm, -(jaw_gap / 2 + jaw_thk)) w=body_len h=jaw_gap + 2 * jaw_thk
    circle pin center=(body_len - 20 mm, 0 mm) dw=body_len h=jaw_gap + 2 * jaw_thk
    circle pin center=(body_len - 20 mm, 0 mm) d=pin_dia
    arc nose through=outline.top_righideh+Y)
  tag jaw_inner_b = slot.side(-Y)

  hole pi + 2 * jaw_thk
   
