tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 
  param thread = "M24x2"

  sketch side on plane.XZ {
    rect outline corner=(0 mm, -(jaw_gap / 2 + jaw_thk)) w=body_len h=jaw_gap + 2*  jaw_thk
    circle pin center=(body_len - 21 mm, 0 mm) d=pin_dia
    arc nose through=outline.top_right, outline.bottom_right tangent_to=outline.right
    constrain concentric(nose, pin)
  }

  extrude body from side.dges edges=[pin_bore.rim(jaw_inner_a), pin_bore.rim(jaw_inner_b)] d=1 mm

  config heavy { pin_dia = 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
