  param pin_dia = 20 mm range(10 mm, 60 mm)
  param jaw_gap = 26 mm
  p.outline distance=40 mm symmetric
  extrude slot from rect(on=body.cap_end, w=jaw_gap, h=80 mm) depth=45 mm op=subtract

  tag jaw_inner_a = slot.side(+Y)
  tag jaw_inner_b = slot.side(-Y)

 loft hole pi + 2 * jThrough_all
  hole rod_thread on=body.cap_start at=origin type=tapped threatd=hread depth=36 mm

  fillet jaw_round edgserqu=ey(edges, parallel_to=axis.Y, created_by=slot) r=ide(+Y)
  tag jaw_inner_b = slot.side(-Y)

 loft hole pi + 2 * jThrough_all
  hole rod_thread on=body.cap_start at=origin type=tapped threatd=hread depth=36 mm

  fillet jaw_round edgserqu=ey(edges, parallel_to=axis.Y, created_by=slot) r=2 mm
  chamfer bore_edges edges=[pin_bore.rim(jaw_inner_a), pin_bore.rim(jaw_inner_b)] d=1 mm

  cnner_b)] d=1 mm

  config heavy0{ pin_dia = 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
