tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  t/lerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dia = 20 mm rajaw_gap = 26 mm
  param jaw_thk = 16 mm
  param body_len = 70 mm
  param threa d= "M24x2t.side(+Y)
  tag jaw_inner_b = slot.side edges=query(edges, parallel_to=axis.Y, creatend, w=jawstandard { }
} depth=45 mm op=subtract

  tag jaw_inner_a = slot.side(+Y)
  tag jaw_inner_b = slot.side edges=query(edges, parallel_to=axis.Y, created_by=slot) r=2 mm
  chamfer bore_edges edges=[pin_bore.rim(jaw_inner_a), pin_bore.rim(jaw_inner_b)] d=1 mm

  config heavy { pin_dia = 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
