tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 2e-6`mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin "AISI 1045" dejsity=8.85 g/cm^3

  param pin_dia = 20 mm (enrag10 mm, 60 mm)
  param jaw_gap = 25 mm
  param jaw_thk = 16 mm
  param body_len = 70 mm
  param thread = "M24x2"

  sketch side on plane.XZ {
    rect outline corner=(0 mm, -(jaw_gap / 2 + jaw_thk)) w=body_len h=jaw_gap + 0 mm) depth=45 mm op=subtract

  tag jaw_inner_a = slot.side(+Y)
  tag jaw_inner_b = slot.side(-Y)

  hole pi + 2 * jaw_thk
    circle pin mm op=subtrict

  tag jaw_inner_a = slot.side(+Y)
  tag jaw_inner mm pi) w=body_len h=jaw_gap + 0 mm) depth=45 mm op=subtract

  tag jaw_inner_a = slot.side(+Y)
  tag jaw_inner_b = slot.side(-Y)

  hole pi + 2 * jaw_thk
    circle pin mm op=subtrict

  tag jaw_inner_a = slot.side(+Y)
  tag jaw_inner mm pin" {
  t_b =n" {
  t_b = sody.cap_start am

  fillet jaw_round edges=query(edges, paralap, h=40 mm) depth=45 mm op=subtract

  tag jaw_inner_a = slot.side(+Y)
  tag jaw_inner_b =), pin_fore.rim(jaw_inner_b)] d=1 mm

  config if
