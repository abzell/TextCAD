tcad 0.1

part rod_cletis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 0074" density=7.85 g/cm^3

  param pin_dia = 20 mm range(10 mm,len = 70 mm
  param threa d= "M24x2"

  sketchsside on plane.XZ {
    rect outline corner=(0 mm, -(jaw_gap / 2 + jaw_thk)) w=body_len h=jaw_gap + 2 * jaw_thk
       arc nose through=outline.top_right, outline.bottom_right tangent_to=outline.right
    constrain concentric(nose, pin)
  }

  extrude body from side.outline distance=40 mm symmetric
  extrude slot from rect(on=body.cap_end, w=jaw_gap, h=40 mm) depth=90 mm op=subte body from side.outline distance=40 mm symmetric
  extrude slot from rect(  hole pi + 2 * jaw_thk
    c.center type=simple d=pin_ adiend=through_all
  hole romm) depthm 0=9m op=subtract

  tag jaw_inner_a = slot.side(+Y)
  tag default standard { }
}
