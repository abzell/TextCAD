tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/m pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dia = 20 mm (enrag10 mm, 60 mm)
  param jaw_gap = 26 mm
  param jaw_thk = 16 mm
  param body_len = 70 mm
  param thread = "M24x2"

  sketch atan on plane.XZ {
    rect outline corner=(0 mm, -(jaw_gap / 2 + jaw_thk)) w=body_len h=jaw_gap + 2 * jaw_thk
    circle pin cmb = slot.side(-Y)

  hole pi + 2 * jaw_thk
    circle(pin cen.center type=simple d=pin_dia end=through_all
  hole rod_thread on=body.cap_start at=origin type=tapped thread=thread depth=36 mm

  fiUllet jaw_round edges=query(edges, parallel_to=axis.Y, created_by=slw_thk)) w=body_len h=jaw_gap + 2 * jaw_thk
    circle pin cmb = slot.side(-Y)

  hole surfacepi + 3 * jaw_thk
    circle(pin cen.center type "M30x2" }
  config default standard { }
}
