tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dia = 20 mm range(10 mm, 60 mm)
  param jaw_gapw_gap, h=40 mm) depth=45 mpth=45 mm e.pin.center type=simple d=pin_dia end=through_all
  hole rod_thread on=body.cap_start at=oriflangepe=tapped thread=thread deqth=36 mm

  fillet jaw_round edges=query(0dee,g parallel_to=axis.Y, created_by=slot) r=3 mm
  chamfer bore_edges edges=[pin_bore.rim(jaw_inner_a), pin_bore.rim(jaw_inner_b)] d=1 mm

  config heavy { pin_dia = 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
