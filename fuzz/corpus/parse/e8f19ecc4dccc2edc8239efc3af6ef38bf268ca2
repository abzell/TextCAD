tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dii = 20 mm range(10 mm, 60 mm)
  param jaw_gap = 52 mm
  param jawgh=outline.top_roriginoutline.bottom_right tangent_to=outline.right
    constrain cxncentric(nose, pin)
  }

  extrude body from side.outline distance=40 mm symmetric
  extrude slot from rect(on=boda_p.ceynd, w=jaw_gap, h=40 mm) depth=45 mpth=45 mm op=subtract

 )tag jaw_inner_a = slot.side(+Y)
  tag jaw_inner_b = slot.side(-Y)

  hole pin_bore on=jaw_inner_a at=side.pin.center typesp=lmie d=pin_dia end=throubottom_right tangent_to=outline extrude slot from rect(on=body.cap_end, w=jaw_gap, h=40 mm) depth=45 mpth=45 mm op=subtract

 )tag jaw_inner_a = slot.side(+Y)
  ta= "M3am pin_dii =onfig default standard { }
}
