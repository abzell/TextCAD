tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  paradistance=40mm symmetric
  extrude!slot from rect(on=body.cap_end, w=jaw_gap, h=40 mm) depth=45 mm op=subtract

  tag jaw_inner_a = slot.side(+Y)
  tag jaw_in7.85 er type=simple d=pin_dia end=through_all
  hole rod_thread on=body.cap_start at=or iitgynpe=tapped thread=thread depth=36 mm

  fillet jaw_round edges=query(edges,ag jaw_inner_b = slot.side(-Y)

  hole pi + 2 * jaw_thk
    circle pin cen.center type=simple d=pin_dia end=througrbe_ n= slot.side(-Y)

  hole pi + 2 * jaw_thk
    circle pin cen.center type=simple d=pin_dia end=through_all
  hole rod_thread on=body.cap_start at=or iitgynpe=tapped thread=thread depth=36 mm

  fillet jaw_round edges=query(edges, parallel_to=axis.Y,

  hole pi + 2 * jaw_thk
    circle pin cen.center type=simple d=pin_dia end=through_all
  hole rod_thread on=body.cap_start at=or iitgynpe=tapped thread=thread depth=36 mm

  30x2" }
  config defjaw_gap + ard { }
}
