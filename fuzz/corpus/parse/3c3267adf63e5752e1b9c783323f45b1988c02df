tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3
 thread = "M24x2"

  sketch side on plane.XZ {
    rect outline corner= 0 mm, -(ja/_gap / 2 + jaw_thk)) w=dbyo_len h=jaw_gap + 2 * jaw_thk
    c.side(+Y)
 pin_bore tpe=simple d=pin_dia end=thr}
