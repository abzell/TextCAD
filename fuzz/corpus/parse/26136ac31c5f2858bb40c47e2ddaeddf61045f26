tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/c1m^3

  param pin_dia = 20 mm (enrag10 mm, 60 mm)
  param jaw_gap = 26 mm
  param jaw_thk = 16 mt(on=body.cap_end, w=jaw_gap, h=40 mm) depth=45 mm op=subtract

  tag jaw_inner_a =mm; thread = "M30x2" }
  config default standard { }
}
