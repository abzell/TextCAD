  material "AISI 1045" density=7.85 g-cm^3

  param pin_=d i a20 mm range(10 mm, 60 mm)
  param jaw_gap = 26 mm
  param j`w_thk = 16 mm
  param body_len = 70 mm
  param thread = "M24x2"

  sketch side on plane.XZ {
    r)   arc nose through=outline.top_right, outline.bottom_ri
  material "AISI body_len - 20 mm, 0 mm) d=pin_dia
    arc nose through=outline.top_right, outline.bottom_right tangent_to=outline.right
    constrainh=outline.top_right, outline.toobtm_ri
  material "AISI bodline.right
    constrain concentric(nose, pin)
  }

  extrude body from side.outline distance=40 mm symmetric
  extrude slot frinner_a= 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
