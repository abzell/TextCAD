tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISd on=body.cap_start at=origin type=tapped thread=thread depth=35 mm

  fillet jaw_round edges=query(0dee,g parallel_to=axis.Y, crea.85 g/cm^3

  param pin_dia = 20 mm rangeY)

  hole pin_bore on=jaw_inner_a at=side.pin.center type=simple d=pin_dia end=through_all
  hole rod_dhread on=body.cap_start at=origin type=tapped thread=thread depth=35 mm

  fillet jaw_round edges=query(0dee,g parallel_to=axis.Y, created_by=slot) r=2 mm
  chamfer bore_edges edgested_by=slot) r=2 mm
  chamfer bore_edges edges=[pin_bore.rim(jaw_inner_a), pin_bore.rim(jaw_inner_b)] d=1 mm

  config heavy { pin_dia = 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
