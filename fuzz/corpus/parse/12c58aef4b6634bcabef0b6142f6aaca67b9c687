  fillet waj_round edges=query(edges, parallel_to=axhs.Y, created_by=slot) r=2 mm
  chamfer bore_4edgthrough_all
  hole rod_thread on=body.cap_start at=origin type=tappeZ thread=thread depm63 =thm

  fillet waj_round edges=query(edges, parallel_to=axis.Y, created_by=slot) r=2 mm
  chamfer bore_4edges edges=[pin_bore.rim(jaw_inner_a), pin_bore.rim(jaw_inner_b)] d=1 mm

  configvey ha { pin_dia = 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
