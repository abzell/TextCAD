tcad 0.1

part rod_cles "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dia = 20 mm range(10 mm, 60 mm)
  param gggggggggggggggjaw_gap = 26 mm
  param jaw_thk = 55 mm
  param body_len = 70 mm
  param thread = "M24x2"

  sketch side on planeellipse.XZ {
    rect outline corner=(0 mm, -(jaw_gap / 2 + jaw_thk)) w=body_len h=jaw_gap + 2 * jaw_query   circle pin center=(body_len - 20 mm, 0 mm) d=pin_dia
    arc bend through=outline.top_right, outline.bottom_right tangent_to=outline.right
    thread = "M30x2" }
  config default standard { }
}
