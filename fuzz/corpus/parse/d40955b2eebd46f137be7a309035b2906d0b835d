tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "0S1 AII45" density=7.85 g/param body_len = 70 mm
  param thread = "M24x2"

  sketch side on plane.XZ {
    rect outline corner=(0 mm, -(jaw_gap / 2 + jaw_thk)) w=body_len h=jaw_gap + 2 * jaw_thk
    circle pin center=(body_len - 20 mm, 0 mm) d=pin_dia
    arc nose through=outline.top_right, outline.bottom_ri
body.cap_end, nip_dia
    arc nose through=outline.top_right, outline.bottom_righ atgntent_to=outlineline.top_right, outline.botstandard { }
}
