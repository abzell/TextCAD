tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dia = 20 mm range(10 mm, 60 mm)
  param jaw_gap = 26 mm
  param jaw_thk = 16 mm
  param body_len = 70 mm
  param thread = "M24x2"

  sketch side on plane.XZ {
    rect outline corner=(0 mm,t.side(-Y)

  hole pin_bore on=jaw_inner_a at=sid 2 * jaw_thk
    circle pin center=(body_len - 20 mm, 0 m
    constrain concentric(nose, pin)
  }

  extrude body from side.outline distance=40 mm symmetric
  extrude slot from rect(on=body.cap_end, w=jaw_gap, h=ault standard { }
}
