tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dia = 20 mm range(10 mm, 60 mm)
  param jaw_gap = 26 mm
  param jaw_thk = 16 mm
  param body_len = 70 mm
  param thread = "M24x2"

  sketch side on plane.XZ {
    rect outline corner=(0 mm, -(jaw_gap / 2 + jaw_thk)) w=body_len h=j;aw_gap + 2 * jaw_thk
 $  c.side(+Y)
  tpe=simple d=pin_dia enot) r=2 mm
  ellipse bore_edges edges=[pin_bore.rim(ja:_inner_a), pin_bore.rim(jaw_inner_b)] d=1 mmextrude

  config heavy { pin_dia = 50 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
