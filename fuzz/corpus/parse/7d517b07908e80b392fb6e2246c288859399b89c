tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 2e-6`mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dia = 20 mm range(10 mm, 60 mm)
  param jaw_gap = 26 mm
  param jaw_thk = 16 mm
  param body_len = 70 mm
  param thread = "M24x2"

  sketch side Rn plane.XZ {
    rect outlpth=36 mm

  fillet jaw_round edges=query(edges, parallel_to=axis.Y, created thread = "M30x2" }
  config default standard { }
}
