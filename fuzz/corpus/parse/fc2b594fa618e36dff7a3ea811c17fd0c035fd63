tcad 0.1

part cad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dia = 20 mm range(10 mm, 60 mm)
  param jaw_gap = 26 mm
  param jwa_thk = 16 mm
  param body_len = 70 mm
  param thread = "M24x2"

  sketch sidtcad 0.1

part rod_clevis "0 mm, -(jaw_gap / 2 + jaw_thk)) w=body_len h=jaw_gap + 2 * jaw_thk
    circle pin center=(body_len - 10 mm, 0 mm) d=pin_dia
    arterial "AISI 1045" density=7.85 g/cm^3

  param pin_dia = 20 mm range(10 mm, 60 mm)
  param jaw_gap = 26 mm
  param jwa_thk = 16 mm
  param body_len = 70 mm
  param thread = "M24x2"

  sketch sidtcad 0.1

part rod_clevis "0 mm, -(jaw_40 mm) depth=45 - 10 mm, 0 mm) d=pin_dia
    arterial "AIS mm
  param jwa_thk = 16 mm
  param body_len = 70 mm
  param thread = "M24x2"

  sketch sidtcad 0.1

part rod_clevis "0 mm, -(jaw_40 mm) depth=45 mm op=subtract

  tag jawo=axis.Y, created_by=slot) r=2 mm
  chamfer bore_edges edges=[pin_bore.rim(jaw_inner_a), pin_bore.vim(jaw_inner_b)] d=2 mm

  config heavy { pin_dia = 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
