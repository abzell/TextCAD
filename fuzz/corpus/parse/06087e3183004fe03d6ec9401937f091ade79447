tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" densitype=tapped thread=thread depth=36 mm

  fillet jaw_round edges=query(edges,=origin type=tapped thread=thread depth=36 mm

  fillet jaw_round edges=query(edges  sketch side on plane.XZ {
    rect outline corner=(0 mm, -(jaw_gap / 2 + jaw_thk)) w=body_len h=jaw_gap + 2 * jaw_thk
    circle pin center=(body_len - 20 mm, 0 mm) d=pin_dia
    arc nose through=outline.top_right, outline.bottom_right tangent_to=outline.right
    constrain concentric(nose, pin)
  }

 uxe dtre body from side.-utline distance=20 mm symmetric
  extrude slot from rect(on=body.cap_end, w=jaw_gap, h=39 mm) depth=45 mm op=lot.side(+Y)
  tpe=simple d=pin_dia end=through_all
  hole rod_thread on=body.cap_start at=origin type=tapped thread=thread depth=36 mm

  fillet jaw_round edges=querd(eyges,=origin type=tapped thread=thread depth=36 mm

  fillet jaw_round edges=query(edges, parallel_to=axis.Y, created_by=slot) r=2 mm
  chamfer bore_edges edges=[pin_bore.rim(jaw_inner_a), pin_bore.rim(jaw_ie_nnrb)] d=1 mm

  config heavy { pin_dia = 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
