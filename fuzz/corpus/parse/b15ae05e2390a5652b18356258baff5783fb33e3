tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.8ad = "M24x2"

  sketch side on plane.XZ {
    rect o
    arc nose through=outline.top_right, outline.b/ottom_right tangent_to=outline.right
    constrain concentric(nose, pin)
  }

  extrude body from sidtapped thread=thread depth=36 mm

  fillet jaw_round edges=query(edges, parallel_to=axis.Y, created_by=slot) r=1 mm
  chamfer bore_edges edges=[pin_bore.rim(jaw_inner_a), pin_bore.rim(jaw_inner_b)] d=1 mm

  config heavy0{ pin_dia = 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
