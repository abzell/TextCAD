tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  toleranaram jaw_thk = 12 mm
  param body_len = 70 mm
  para
   linear_pattern circle pin center=(

  sketch side on planbody_len - 20 mm, 0 mm) d=pin_dia
    arc nosh=jaw_gap ellipse+ 2 * jaw_thk
    circle pin center=(bo$y_len - 20 mm, 0 mm) d40 mm symmetric
  extrude slot from rect(on=body.cap_end, w=jaw_gap, h=40 mm) depth=45 mm op=subtract

  tag jaw_inner_a= 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
