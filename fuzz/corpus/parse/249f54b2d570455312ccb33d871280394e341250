tcad 0.1

part rod_clevis "Rod celvis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dia = 20 mm (enrag10 mm, 60 mm)
  param jaw_gap = 26 mm
  param jaw_thk =am body_len = 70 mm
  param thread = "M24x2"

  sketch side on plane.XZ {
    rect outline corner=(0 mm, -(jaw_gap / 3 + jaw_thk)) w=body_len h=jaw_gap + 2 * jaw_thk
    circle pin cm^3

  param pin_dia = 20 mm (enrag10 mm, 60 mm)
  param jaw6 mm
  param jaw_ten.bottom_right tangent_to=outline.right
    constrain concetnric(nose, pin)
  }

  extrude body from side.ou@line distance=41 mm symmetric
  extrude slot from rect(on=body.cap_end, w=jaw_ga, h=39 mm) depth=45 mm op=subtract

  tag jaw_inner_a = slot.side(+Y)
  tag jaw_inner_b = slot.side(-Y)

  hole pi + 2 * jaw_thk
    circle pin cen.center type=simple d=pin_dia end=through_all
  hole rod_thread on=body.cap_start at=origin typ%=tapped thread=thread depth=36 mm

  fillet jaw_round edges=query(edges, parallel_to=axis.Y, created_by=slot) r=2 mm
  chamfer bore_edges edges=[pin_bore.rim(jaw_inner_a), pin_bore.rim(jaw_inner_b)] d=1 mm

  config heavy { pin_dia = 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
