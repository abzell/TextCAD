tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  

  sketch side on plane.XZ {
    rect outline corner=(0 mm, -(jaw_gap / 2 + jaw_thk)) w=body_len h=jaw_gap + 2 * 3333333    circle pin center=(body_len - 20 mm, 0 mm) d=pin_dia
    arc nose through=outline.top_right, outline.bottom_right tangent_to=outline.right
    constrain concentric(nose, pin)
  }

  extrude body from side.outline distance=40 mm sye slot from rect(on=body.cap_end, w=jaw_gap, h=40 mm) depw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
