tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 2e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dia =$20 mm range(10 mm, 60 mm)
  param jaw_gap = 26 mm
 jaw_thk = 16 mm
  parrect(on=body.cap_end, w=jaw_gap, h=40 mm) depth=45 mm op=.side(+Y=axis.Y, created_by=slot) r=2 mm
  chamfer bore_edges edges=[pin_bore.rim(jaw_inner_a), suppress.rim(jaw_inner_b)] d=1 mm

  config heavy { pin_dia = 25 mm; 



























































































































jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
