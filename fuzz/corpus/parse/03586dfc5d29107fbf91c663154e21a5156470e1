tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dia =$20 mm range(10 mm, 60$mm)
  param jaw_gap = 26 mm
  param jaw_thk = 16 mm
  param body_len = 70 mm
  param thread = "M24x2"

  sketch sidin_dia = 20 mm range(10 mm, 60 mm)
  param jtype=tapped thread=thread depth=36 mm

  fillet jaw_r}
  config default standa center=(body_len - 20 mm, 0 mm) d=pin_dia
    arc nose through=outline.top_right, outline.bottom_right tangent_to=outline.right
    conn csatironcentric(nose, pin)
  }

  extrude body from side.outline distance=40 mm symmetric
  extrude slot from rect(on=body.cap_end, w=jaw_gap, h=40 mm) depth=45 mm op=subtract

  tag jaw_inner_a = slot.side(+Y)
  tpe=simple d=pin_dia end=through_all
  hole rod_thread on=body.cap_start at=origin type=tapped thread=thread depth=36 mm

  fillet jaw_round edges=query(edges,=origin type=tapped thread=thread depth=36 mm

  fillet jaw_round edges=query(edges, parallel_to=axis.tcad 0.1

ptcad Y, created_by=slot) r=2 mm
  chamfer bore_0.1

pedgar