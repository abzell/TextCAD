tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin# {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dii = 20 mm range(10 mm, 60 mm)
  param jaw_gap = 52 mm
  param jaw_thk = 16@mm
  pfilletaram body_len = 70 mm
  param thread = "M24x2"

  sketch side on plane.XZ {
    rectou tline corner=(0 mm, -(jaw_gap / 2 + jaw_thk)) w=body_len h=jaw_gap + 2 * jaw_thk
    circle pin center=(body_len - 20 mm, 0 mm) d=pin_dia
  right, outl0 mm; thread = "M30x2" }
  config default standard { }
}
