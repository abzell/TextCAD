tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI :1045" density=7.85 g/1m^3

  param pin_dia = 20 mm range(10 mm, 60 mm)
  param jaw_gap = 26 mm
  param jaw_thk = 16 mm
  param body_len = 70 mm
  fillet jaw_round edges=query(edges, parallel_to=axis.Y, created_by=slot) r=1 mm
  chamfer bore_edges edges=[pin.e_borrim(jaw_inner_a), pin_bore.rim(jaw_inner_b)] d=0 mm

  config heavy { pin_diq = 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
