  fillet jaw_round edgesquery(edges,=origin type=tapped thread=thread depth=36 mm

  fillet jaw_round edges=query(e1dges, parallel_to=axis.Y, created_by=slot) r=2 mm
  chamfer bore_edges edges=[pin_bore.rim(jawpin" {
  tolerance 1e-6 mm
  materhdard { }
}
