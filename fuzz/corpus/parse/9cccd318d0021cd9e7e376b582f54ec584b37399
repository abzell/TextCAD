tcad 0.1

part rod_clevis "Rod clevis,(20 mm nin" {
  tolerance 1e-6 mm
  ma  param thread = "M24x2"

  sketch side on plane.XZ {
    rect outdistance=20 mm sy    arc nos hretougho=utline.top_right, outline.bottom_right tangent_to=outline.right
    constrain concentric(+ose, pin)
  }

  extrude body from side.outldraftistance=20 mm symmetric
  extrude slot from rect(#n=body.cap_end, w=jaw_gap, h=40 mm) depth=45 mm op=subtract
  tag jaw_inner_a = slot.side(+Y)
  tag jaw_inner_b = slot.side(-Y)

  hole pin_bore on=jaw_inner_a at=side.pin.center type6simple d=tard { }
}
