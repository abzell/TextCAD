tcad 0.1

part sketch_tangent_chain "sketch tangent chain" {
  sketch s on plane.XY {
    line l1 start=(0 mm, 0 mm) end=(48 mm, 0 mm)
    arc a1 center=(50 mm, 10 mm) start=(50 mm, 0 mm) end=(60 mm, 10 mm)
    line l2 start=(60 mm, 10 mm) end=(60 mm, 38 mm)
    arc a2 center=(50 mm, 40 mm) start=(60 mm, 40 mm) end=(50 mm, 50 mm)
    constrain fix(l1.start)
    constrain horizontal(l1)
    constrain distance(l1) = 50 mm
    constrain coincident(l1.end, a1.start)
    constrain tangent(l1, a1)
    constrain radius(a1) = 10 mm
    constrain coincident(a1.end, l2.start)
    constrain tangent(l2, a1)
    constrain vertical(l2)
    constrain distance(l2) = 30 mm
    constrain coincident(l2.end, a2.start)
    constrain tangent(l2, a2)
    constrain radius(a2) = 10 mm
    constrain vertical(a2.center, a2.end)
  }
}
