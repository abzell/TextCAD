tcad 0.1

part sketch_fully_constrained "sketch fully constrained" {
  sketch s on plane.XY {
    rect plate corner=(1 mm, 1 mm) w=60 mm h=30 mm
    circle hole center=(20 mm, 15 mm) d=8 mm
    line diag start=plate.bottom_left end=plate.top_right
    constrain fix(plate.bottom_left)
    constrain fix(hole.center)
  }
}
