tcad 0.1

part rod_clevis "Rod clevis, 20 mm pin" {
  tolerance 1e-6 mm
  material "AISI 1045" density=7.85 g/cm^3

  param pin_dia = 20 mm range(10 mm, 60 mm)
  param jaw_gap = 26 mm
  param jaw_thk = 16 mm
  param body_len = 70 mm
  param thread = "M24x2"

  sketch side on plane.XY {
    rect outline corner=(0 mm, -(jaw_gap / 2 + jaw_thk)) w=body_len h=jaw_gap + 2 * jaw_thk
  }
  extrude body from side.outline distance=40 mm symmetric

  sketch fork on plane.XY {
    rect gap corner=(30 mm, -(jaw_gap / 2)) w=body_len - 30 mm + 5 mm h=jaw_gap
  }
  extrude slot from fork.gap op=subtract symmetric through_all

  tag jaw_inner_a = slot.side(fork.gap.top)
  tag jaw_inner_b = slot.side(fork.gap.bottom)
  tag gap_floor = slot.side(fork.gap.left)

  fillet root_round edges=[edge(gap_floor & jaw_inner_a), edge(gap_floor & jaw_inner_b)] r=4 mm
  fillet nose_round edges=[edge(body.side(side.outline.right)#2 & body.side(side.outline.top)), edge(body.side(side.outline.right)#1 & body.side(side.outline.bottom))] r=4 mm

  hole pin_bore on=body.side(side.outline.top) at=(-(body_len - 20 mm), 0 mm) d=pin_dia end=through_all
  hole rod_thread on=body.side(side.outline.left) at=(0 mm, 0 mm) thread=thread depth=28 mm

  chamfer bore_edges edges=[edge(body.side(side.outline.top) & pin_bore.wall#2), edge(body.side(side.outline.bottom) & pin_bore.wall#1)] d=1.5 mm

  config heavy { pin_dia = 25 mm; jaw_thk = 20 mm; thread = "M30x2" }
  config default standard { }
}
