{
  "name": "textcad",
  "displayName": "TextCAD",
  "description": "Language support and 3D viewer for TextCAD (.tcad) parts. Works in VS Code and Eclipse Theia.",
  "version": "0.0.1",
  "publisher": "textcad",
  "license": "Apache-2.0",
  "private": true,
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages", "Visualization"],
  "main": "./dist/extension.js",
  "activationEvents": ["onLanguage:textcad", "onCommand:textcad.openViewer"],
  "contributes": {
    "languages": [
      {
        "id": "textcad",
        "aliases": ["TextCAD", "tcad"],
        "extensions": [".tcad"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "textcad", "scopeName": "source.textcad", "path": "./syntaxes/textcad.tmLanguage.json" }
    ],
    "commands": [
      { "command": "textcad.openViewer", "title": "TextCAD: Open Viewer" },
      { "command": "textcad.restartServer", "title": "TextCAD: Restart Language Server" }
    ],
    "configuration": {
      "title": "TextCAD",
      "properties": {
        "textcad.languageServerPath": {
          "type": "string",
          "default": "tcad-lsp",
          "description": "Path of the tcad-lsp executable."
        },
        "textcad.cliPath": {
          "type": "string",
          "default": "tcad",
          "description": "Path of the tcad executable (used by the viewer; it must be built with the OpenCASCADE kernel)."
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "package": "npm run build && vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "@types/vscode": "1.85.0",
    "esbuild": "0.25.0",
    "typescript": "5.6.3"
  }
}
